# Copie ce fichier en `supabase/.env.local` (déjà gitignoré) et remplis les valeurs.
# SUPABASE_URL et SERVICE_ROLE_KEY : affichés par `supabase start` (section "API URL" / "service_role key").
# Les clés VAPID doivent être les MÊMES que celles utilisées pour créer ta subscription
# push réelle (Supabase → Edge Functions → Secrets côté prod), sinon le navigateur
# rejettera le push (signature invalide).

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
